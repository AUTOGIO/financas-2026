.DS_Store
Icon
Icon?
.AppleDouble
.LSOverride

# Logs and temp
logs/
tmp/
*.log
*.tmp

# Generated analytics output (rebuild: python3 sync.py / make sync)
data/insights.json

# Secrets / env
.env
.env.*
!.env.example

