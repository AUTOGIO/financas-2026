__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node (if added later)
node_modules/
dist/
build/

# Editors / local
.idea/
.vscode/
.claude/
*.swp
*~

# Workbook and file session backups
*.backup-*.xlsx
*.backup-*

# NFC-e regenerated pipeline outputs (rebuild: python3 src/nfce/personal_inflation.py)
src/nfce/personal_inflation_data.json
src/nfce/personal_inflation_validation.json
src/nfce/personal_inflation_extracted_items.json
src/nfce/nfce_all.json
src/nfce/inflation_data.json
src/nfce/nfce_items.csv
src/nfce/nfce_transactions.csv

# Litoral store track (rebuild: python3 src/nfce/litoral_store_prices.py)
src/nfce/litoral_price_data.json
src/nfce/litoral_price_validation.json
# Local symlink/copy of Downloads/NOTAS_LITORAL (~330MB) — do not commit XMLs
src/nfce/notas_litoral

# Too large for GitHub (>100MB); keep local only
src/nfce/notas/nfce.pdf

# NFC-e receipt XMLs are personal purchase history — keep out of git.
# The paths under src/nfce/notas/ are usually symlinks to $HOME/.financas-notas/
# (see AUDIT-002 in REPOSITORY_AUDIT.md). Match both plain dirs and symlinks
# by omitting the trailing slash.
src/nfce/notas/NFCE_XML_*
src/nfce/notas/NFCE_*.txt
